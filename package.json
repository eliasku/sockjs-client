{
  "name": "@eliasku/sockjs-client",
  "version": "0.0.6",
  "module": "dist/sockjs.js",
  "types": "dist/entry.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/sockjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -b",
    "fix": "vp fmt && vp lint --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test",
    "build": "vp pack",
    "check": "vp check && npm run typecheck",
    "verify": "npm run check && npm test && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
