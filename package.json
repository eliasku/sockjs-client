{
  "name": "@eliasku/sockjs-client",
  "version": "0.0.6",
  "module": "dist/sockjs.js",
  "types": "dist/entry.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/sockjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc",
    "fix": "oxfmt && oxlint --fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "rolldown -c rolldown.config.ts && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.83.0",
    "rolldown": "^1.2.8",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
